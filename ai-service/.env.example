# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Agent Models ──────────────────────────────────────────────────────────────
# Supported: gpt-4o, gpt-4o-mini, gpt-4-turbo
CLASSIFIER_MODEL=gpt-4o-mini
PLANNER_MODEL=gpt-4o-mini
MONITOR_MODEL=gpt-4o-mini

# ── Spring Boot ───────────────────────────────────────────────────────────────
SPRING_BACKEND_URL=http://localhost:8080/api
INTERNAL_SECRET=change-me-in-production

# ── Service ───────────────────────────────────────────────────────────────────
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Tool Tuning ───────────────────────────────────────────────────────────────
# Max tool call rounds per agent per task
TOOL_MAX_ROUNDS=5
